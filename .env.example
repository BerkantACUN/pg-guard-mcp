# Copy to .env or set in your MCP client's env config. Never commit real
# credentials — this file documents the shape, it holds no real secret.

# Full libpq connection string. Preferred over the individual PG* vars below.
PG_GUARD_DSN=host=127.0.0.1 dbname=mydb user=myapp_readonly password=change_me

# Optional tuning (defaults shown):
# PG_GUARD_ROW_LIMIT=1000
# PG_GUARD_STATEMENT_TIMEOUT_MS=10000

# Optional: confine pg_check_migration_file to this directory. Unset by
# default, meaning it reads any path this process can access — see that
# tool's docstring in server.py for why.
# PG_GUARD_MIGRATIONS_DIR=/path/to/your/migrations
